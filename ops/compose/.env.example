# =========================================================================
# Platform base stack environment (template).
# bootstrap.sh copies this to .env and fills every __GEN_* placeholder
# with a random secret. NEVER commit the real .env. NEVER put LLM provider
# keys in this file's committed form — fill them on the server after
# bootstrap (they are read by LiteLLM only).
# =========================================================================

# --- Domain & TLS ---------------------------------------------------------
# 6 DNS A records must point at this server before bootstrap:
# api / langfuse / zot / bao / litellm / restate
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# --- PostgreSQL 16 (shared instance, three databases) ---------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GEN_PG_SUPER__
# Per-database roles created by ops/sql/001_databases.sql:
KERNEL_PG_PASSWORD=__GEN_PG_KERNEL__
LITELLM_PG_PASSWORD=__GEN_PG_LITELLM__
LANGFUSE_PG_PASSWORD=__GEN_PG_LANGFUSE__

# --- OpenBao ---------------------------------------------------------------
# Root token and unseal key are GENERATED BY `bao operator init` during
# bootstrap and printed to the terminal ONLY (manual §4.2 rule).
# Nothing secret lives in this file for Bao.

# --- LiteLLM ---------------------------------------------------------------
LITELLM_MASTER_KEY=__GEN_LITELLM_MASTER__
# Real provider keys (optional at bootstrap, fill on server):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=

# --- Zot registry ----------------------------------------------------------
ZOT_USER=admin
ZOT_PASSWORD=__GEN_ZOT_PASSWORD__
# Filled by bootstrap via `caddy hash-password` (bcrypt):
ZOT_PASS_BCRYPT=__GEN_ZOT_BCRYPT__

# --- Langfuse --------------------------------------------------------------
# NEXTAUTH_URL is derived from DOMAIN by bootstrap.
NEXTAUTH_URL=https://langfuse.example.com
NEXTAUTH_SECRET=__GEN_NEXTAUTH_SECRET__
ENCRYPTION_KEY=__GEN_LF_ENCRYPTION__
SALT=__GEN_LF_SALT__
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=__GEN_CLICKHOUSE_PASSWORD__
REDIS_AUTH=__GEN_REDIS_AUTH__
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=__GEN_MINIO_ROOT_PASSWORD__
# First admin user (optional, filled by human on server):
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# --- TigerBeetle (added by WO-05; unused until then) -----------------------
# TB_CLUSTER_ID=0

# --- JiuwenBox sandbox (4.3): pin to your openJiuWen release ----------
# JIWUENBOX_IMAGE=ghcr.io/openjiuwen/jiuwenbox:0.x.y

# --- edge-server co-location (docker-compose.edge.yml, ADR 0004) -----------
# Specific host IPs (wildcard :443 conflicts with hf-sni-router loopback binds)
EDGE_IPV4=10.1.0.12
EDGE_IPV6=2402:4e00:c011:2700:242a:610a:7a8a:0
